; GameAssistantDLL.def : 声明 DLL 的模块参数。
; 不指定 LIBRARY 指令，DLL 内部名自动取输出文件名
; （Win32 -> GameAssistantDLL32.dll，x64 -> GameAssistantDLL64.dll）

EXPORTS
    InitClient
    UninitClient
    IsClientConnected
    SendTestData
    ExecuteLuaScript
    PauseLuaScript
    ResumeLuaScript
    StopLuaScript
    IsLuaScriptRunning
    IsLuaScriptPaused
    ReportAccountInfo
    ReportScriptStatus